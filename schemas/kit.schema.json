{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Kit DevKitTools",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion","sku","idTecnico","slug","nome","categoria","versao","estadoTecnico","estadoComercial","origem","runtime","dependenciaPagaObrigatoria","dependenciasOpcionais","upstreams","inclui","naoInclui","comandosValidacao","precoSugeridoBRL","documentacaoConferida","licencasConferidas","build"],
  "properties": {
    "schemaVersion": {"type":"integer","enum":[1]},
    "sku": {"type":"string","pattern":"^DKT-[A-Z0-9]+-[0-9]{3}$"},
    "idTecnico": {"type":"string","pattern":"^artisys-[a-z0-9-]+$"},
    "slug": {"type":"string","pattern":"^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "nome": {"type":"string","pattern":"^.+$"},
    "categoria": {"type":"string","pattern":"^.+$"},
    "versao": {"type":"string","pattern":"^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"},
    "estadoTecnico": {"type":"string","enum":["stable","implemented"]},
    "estadoComercial": {"type":"string","enum":["planejado","preparando","qa","pronto","pausado","descontinuado"]},
    "origem": {"type":"object","additionalProperties":false,"required":["repositorio","caminho"],"properties":{"repositorio":{"type":"string"},"caminho":{"type":"string"},"commit":{"type":["string","null"]}}},
    "runtime": {"type":"array","items":{"type":"string"},"uniqueItems":true},
    "dependenciaPagaObrigatoria": {"type":"boolean"},
    "dependenciasOpcionais": {"type":"array","items":{"type":"string"}},
    "upstreams": {"type":"array","items":{"type":"string"}},
    "inclui": {"type":"array","items":{"type":"string"}},
    "naoInclui": {"type":"array","items":{"type":"string"}},
    "comandosValidacao": {"type":"array","items":{"type":"string"}},
    "precoSugeridoBRL": {"type":["number","null"],"minimum":0},
    "documentacaoConferida": {"type":"boolean"},
    "licencasConferidas": {"type":"boolean"},
    "build": {"type":"object","additionalProperties":false,"required":["habilitado"],"properties":{"habilitado":{"type":"boolean"}}}
  }
}
