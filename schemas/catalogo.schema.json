{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"Catálogo DevKitTools",
  "type":"object",
  "additionalProperties":false,
  "required":["schemaVersion","locale","modoDistribuicao","kits"],
  "properties":{
    "schemaVersion":{"type":"integer","enum":[1]},
    "locale":{"type":"string","enum":["pt-BR"]},
    "modoDistribuicao":{"type":"string","enum":["publico-desenvolvimento","privado"]},
    "kits":{"type":"array","items":{"$ref":"kit.schema.json"},"minItems":1}
  }
}
